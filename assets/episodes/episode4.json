  "npcs": [
    {
      "x": 2,
      "y": 1,
      "name": "Shadow Keeper",
      "dialogue": [
        "Ahh... a traveler in my realm. Welcome, lost one.",
        "The shadows hide many paths... but not all lead forward.",
        "Ironic, isn't it? Light reveals, but darkness conceals.",
        "Some checkpoints illuminate hidden passages. Seek them wisely.",
        "The ice betrays more than stone ever could. Tread carefully."
      ]
    },
    {
      "x": 10,
      "y": 7,
      "name": "Path Watcher",
      "dialogue": [
        "Three checkpoints guard the heart of this maze.",
        "The left path? Quick and deadly - ice needles pierce the unwary.",
        "The right path winds long but forgives mistakes - bridges glow when safe.",
        "The center path demands patience - activate checkpoints SEQUENCE matters.",
        "Break the order and the shadows seal the way. Trust the pillars."
      ]
    },
    {
      "x": 16,
      "y": 12,
      "name": "Exit Guardian",
      "dialogue": [
        "The shadow gate whispers of your approach... impressive.",
        "One final checkpoint stands between you and freedom.",
        "The ice here lies dormant but not defeated - it waits for missteps.",
        "You've come so far. The exit awaits your claim!",
        "Go forth, champion. The darkness remembers those who persevered."
      ]
    }
  ],
